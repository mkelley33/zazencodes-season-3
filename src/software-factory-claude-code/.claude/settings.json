{
  "permissions": {
    "allow": ["Bash(gh issue comment *)", "Bash(gh issue edit *)"]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/factory-guard.sh\""
          }
        ]
      }
    ]
  }
}
